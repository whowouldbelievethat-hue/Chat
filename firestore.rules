rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{u} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == u;
    }

    match /chats/{c} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;

      match /messages/{m} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members
          && request.resource.data.from == request.auth.uid;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members
          && (resource.data.from == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if false;
      }
    }
  }
}
